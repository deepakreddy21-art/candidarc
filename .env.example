# CandidArc environment example
NODE_ENV=development
APP_MODE=demo
WORKER_KIND=all
CANDIDARC_DATA_MODE=memory
# CANDIDARC_DATA_MODE=postgres
# DATABASE_URL=postgres://candidarc:candidarc@127.0.0.1:5432/candidarc

REDIS_URL=redis://127.0.0.1:6379
QUEUE_BACKEND=inprocess
SESSION_SECRET=candidarc-dev-session-secret-change-me!!
# CSRF_SECRET=optional-separate-secret-at-least-32-chars
APP_URL=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/storage
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=candidarc
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

AI_MODE=mock
AI_GENERATION_PROVIDER=openai
AI_HR_AUDIT_PROVIDER=anthropic
AI_EM_AUDIT_PROVIDER=anthropic
AI_FINAL_REVIEW_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
ANTHROPIC_AUDIT_MODEL=claude-sonnet-4-20250514
OPENAI_FINAL_MODEL=gpt-4o-mini
# Legacy compatibility: AI_PROVIDER=mock|openai

# Python resume intelligence (internal BFF only)
RESUME_INTELLIGENCE_BACKEND=typescript
PYTHON_BACKEND_URL=http://127.0.0.1:8090
PYTHON_BACKEND_TOKEN=dev-python-backend-token-change-me
# Shadow mode sampling (0-100). Default 0 = off. Never charges the customer.
SHADOW_SAMPLE_PERCENT=0
# Evidence store for Python (memory allowed in demo; postgres required in production)
EVIDENCE_STORE=memory
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=mock-hash-v1
# EMBEDDING_DIMENSIONS=1536
# RANKER_BACKEND=hybrid
# ENABLE_CROSS_ENCODER=false
# RUN_LIVE_PROVIDER_TESTS=0

WORKFLOW_ENGINE=db
# TEMPORAL_ADDRESS=localhost:7233

LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

# Client
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_USE_MOCK_API=false

# Radar connectors (optional)
# USAJOBS_API_KEY=
# GREENHOUSE_LIVE=1
# Licensed partner adapters remain disabled until set:
# LINKEDIN_PARTNER_CREDENTIALS=
# INDEED_PARTNER_CREDENTIALS=

# Application Copilot — keep authorized submission off until a permitted connector exists
# COPILOT_AUTHORIZED_SUBMISSION=true
