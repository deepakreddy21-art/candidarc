# Optional S3-compatible configuration; provision a private bucket separately.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=candidarc-private
S3_ACCESS_KEY=<secret-manager-reference>
S3_SECRET_KEY=<secret-manager-reference>
# Total = (web processes + worker processes)*DATABASE_POOL_MAX
# + Python processes*PYTHON_DATABASE_POOL_MAX + operator reserve.
DATABASE_POOL_MAX=5
PYTHON_DATABASE_POOL_MAX=5
