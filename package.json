{
  "name": "candidarc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:web": "next dev --turbopack",
    "dev:worker": "tsx server/worker/main.ts",
    "dev:stack": "concurrently -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:python": "node scripts/python.mjs -m uvicorn app.main:app --reload --port 8090",
    "lint:python": "node scripts/python.mjs -m ruff check app tests",
    "typecheck:python": "node scripts/python.mjs -m mypy app",
    "test:python": "node scripts/python.mjs -m pytest -q",
    "test:python-mode": "node scripts/python-mode-test.mjs",
    "contract:python": "node scripts/python.mjs scripts/export_openapi.py && node scripts/python.mjs scripts/generate_ts_contract.py",
    "eval:resume": "node scripts/python.mjs -m evals.run_eval",
    "smoke:docker": "node scripts/smoke-docker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/test/integration",
    "test:production": "vitest run src/test/production-readiness",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/database/migrate.ts",
    "db:seed": "tsx server/database/seed-cli.ts",
    "worker": "tsx server/worker/main.ts",
    "worker:general": "cross-env WORKER_KIND=general tsx server/worker/main.ts",
    "worker:ingestion": "cross-env WORKER_KIND=ingestion tsx server/worker/main.ts",
    "worker:document": "cross-env WORKER_KIND=document tsx server/worker/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.8",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.3.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "^1.2.11",
    "@radix-ui/react-tooltip": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.9.2",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.503.0",
    "mammoth": "^1.12.2",
    "nanoid": "^6.0.1",
    "next": "^15.3.1",
    "next-themes": "^0.4.6",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "uuid": "^14.0.2",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.4.49"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
